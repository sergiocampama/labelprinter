<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK target gives access to Windows.Data.Pdf, the PDF
         renderer built into Windows (PdfLabelRenderer.cs). Runs on Windows 10 1809+. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Identity / versioning. The release script overrides Version via
         -p:Version=<v>, so the running build reports the version it shipped as. -->
    <AssemblyName>LabelPrinter</AssemblyName>
    <RootNamespace>LabelPrinter</RootNamespace>
    <Version>1.0.0</Version>
    <Product>LabelPrinter</Product>
    <ApplicationIcon>Assets\labelprinter.ico</ApplicationIcon>

    <!-- Ships as win-x64 self-contained (see deploy/build-release.ps1): one
         build for x64 Windows and Windows 11 on ARM (through its x64
         emulation). Not x86: under .NET 10 x86, SkiaSharp (used by the ZPL
         preview) misbehaves: every ^FB text field comes out blank, and many
         native calls in a row end in a stack overflow. The same code works
         on .NET 8 x86, and on .NET 10 x64 and ARM64. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep in step with the vpk CLI version used by deploy/build-release.ps1. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- Draws ZPL labels locally for the preview (ZplPreview.cs). It pulls in
         SixLabors.ImageSharp 3.1.12, which has published advisories for crafted
         images; the fixed 4.x line needs a paid license key to build. The
         preview only parses files the user picks. -->
    <PackageReference Include="BinaryKits.Zpl.Viewer" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped next to the exe so the tray can load the small icon frame. -->
    <Content Include="Assets\labelprinter.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
